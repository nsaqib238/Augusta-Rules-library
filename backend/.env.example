# Augusta Rules Library backend — copy to backend/.env and fill in values.
# Do NOT commit backend/.env (secrets).
# Do NOT copy .env from Augusta-Australia (different Supabase, domain, port, Stripe).
# See APP_SEPARATION.md
#
# Roles:
#   VPS1 (API):  WORKER_MODE=api, EXTERNAL_PDF_WORKER=true, REDIS_URL=.../1
#   VPS2 (PDF):  WORKER_MODE=pdf, EXTERNAL_PDF_WORKER=true, HEALTH_REQUIRE_REDIS=false
#   Local Windows: leave REDIS_URL unset; EXTERNAL_PDF_WORKER=false (or omit)

# =============================================================================
# Required
# =============================================================================
SUPABASE_URL=https://your-library-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

OPENAI_API_KEY=sk-...
# Optional OpenAI project / default model used by PDF pipeline AI helpers
# OPENAI_PROJECT_ID=proj_...
# OPENAI_MODEL=gpt-4o-mini

# CORS + Stripe redirect validation (comma-separated; never use * in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production (library app ONLY — never ausstd):
# ALLOWED_ORIGINS=https://library.augustasearch.com,https://www.augustasearch.com

# Public app URL (admin emails, redirects)
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://library.augustasearch.com

# Admin emails granted API/UI admin without profiles.role (comma-separated)
ADMIN_EMAIL_ALLOWLIST=
# From-address used in some admin notification emails
# ADMIN_EMAIL=admin@yourcompany.com
# APP_NAME=Augusta Rules Library

# =============================================================================
# Gemini — primary provider (OpenAI remains fallback for rate limit / quota / overload)
# =============================================================================
# Get a key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# LLM_PRIMARY_PROVIDER=gemini
# LLM_FALLBACK_ENABLED=true
# GEMINI_ROUTER_MODEL=gemini-flash-latest
# GEMINI_SYNTHESIS_MODEL=gemini-pro-latest
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# =============================================================================
# Modal PDF extraction
# =============================================================================
MODAL_ENDPOINT=https://your-workspace--pdf-table-extractor-v3-extract-tables.modal.run
MODAL_API_SECRET=
MODAL_TIMEOUT=21600
AUTO_PROCESS_PDF_ON_UPLOAD=true
DISABLE_MODAL=false

# Upload / pipeline gates
PDF_PIPELINE_ENHANCEMENT=false
PDF_UPLOAD_REJECT_SCANNED=true
PDF_UPLOAD_MIN_AVG_CHARS_PER_PAGE=100
PDF_PIPELINE_TEXT_PREFLIGHT=false
PDF_PIPELINE_PREFLIGHT_MAX_SAMPLE_PAGES=10
PDF_PIPELINE_DEBUG_SAVE_OUTPUTS=false
# PDF_PIPELINE_DEBUG_OUTPUT_DIR=

# Optional Adobe hybrid OCR (PDF pipeline)
# ADOBE_CLIENT_ID=
# ADOBE_CLIENT_SECRET=
# ADOBE_ORG_ID=
# ENABLE_ADOBE_HYBRID=true

# Ingest quality guards
# PDF_INGEST_MAX_UNKNOWN_TOKEN_RATIO=0.02
# PDF_INGEST_MAX_UNKNOWN_TOKENS=200
# PDF_INGEST_MAX_NOISE_RUNS=25

# =============================================================================
# Stripe — separate webhook + prices from Augusta-Australia
# Webhook URL: https://library.augustasearch.com/api/v1/webhooks/stripe
# =============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PROFESSIONAL=price_...
# Company seats (create prices in Stripe: $599/25 seats, $1099/50 seats AUD):
# STRIPE_PRICE_COMPANY_SMALL=price_...
# STRIPE_PRICE_COMPANY_LARGE=price_...
# Optional legacy / alternate price IDs:
# STRIPE_PRICE_INDIVIDUAL_MONTHLY=price_...
# STRIPE_PRICE_SOLE_TRADER=price_...

# =============================================================================
# Storage (Supabase S3-compatible API — optional if using default storage client)
# =============================================================================
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=documents
# S3_REGION=us-east-1
# BENCHMARK_SUPABASE_BUCKET=documents

# =============================================================================
# Email (admin notifications + customer welcome)
# =============================================================================
# SMTP_SERVER=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@augustasearch.com
# SMTP_FROM_NAME=Augusta Rules Library
# SUPPORT_EMAIL=naajm@augustasearch.com
# WELCOME_EMAIL_ENABLED=true
# LEGAL_TERMS_URL=https://www.augustasearch.com/terms.html
# LEGAL_PRIVACY_URL=https://www.augustasearch.com/privacy.html
# MARKETING_SITE_URL=https://www.augustasearch.com

# =============================================================================
# Sessions / health / debug
# =============================================================================
ASK_EXECUTOR_MAX_WORKERS=32
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
SESSION_CHECK_CACHE_SECONDS=30
MAX_CONCURRENT_SESSIONS=5
SESSION_IDLE_MINUTES=30
HEALTH_REQUIRE_OPENAI=false
HEALTH_REQUIRE_REDIS=false
BACKEND_DEBUG_LOG=false
BACKEND_DEBUG_LOG_PATH=backend_debug.log

# Local uvicorn only (production uses UVICORN_* via start-api.sh / systemd)
# Use 8001 if Augusta-Australia is already on 8000 locally
# API_HOST=0.0.0.0
# API_PORT=8001

# =============================================================================
# Stage S1 — infrastructure scale (production VPS1)
# =============================================================================
WORKER_MODE=api
EXTERNAL_PDF_WORKER=false
UVICORN_WORKERS=3
UVICORN_LIMIT_CONCURRENCY=96
UVICORN_PORT=8083
# Redis DB /1 — do not share /0 with Augusta-Australia
# REDIS_URL=redis://127.0.0.1:6379/1
PDF_QUEUE_BACKEND=postgres
PDF_JOB_MAX_CONCURRENT=2
PDF_JOB_MAX_PER_USER=2
PDF_JOB_STALE_MINUTES=90
PDF_WORKER_POLL_SECONDS=2
ASK_MAX_CONCURRENT_PER_USER=2
ASK_GLOBAL_MAX_INFLIGHT=80
ASK_INFLIGHT_TTL_SECONDS=3600

# Production VPS1 typical:
# EXTERNAL_PDF_WORKER=true
# REDIS_URL=redis://127.0.0.1:6379/1
# HEALTH_REQUIRE_REDIS=true

# Production VPS2 (PDF worker only):
# WORKER_MODE=pdf
# EXTERNAL_PDF_WORKER=true
# PDF_JOB_MAX_CONCURRENT=4
# HEALTH_REQUIRE_REDIS=false

# =============================================================================
# Free-ask daily budget (Sole plan only; Professional bypasses)
# =============================================================================
FREE_ASK_QUOTA_ENABLED=true
FREE_ASK_DAILY_GLOBAL_LIMIT=80
FREE_ASK_DAILY_PER_USER_LIMIT=5
FREE_ASK_TIMEZONE=Australia/Sydney

# =============================================================================
# Shared-library answer cache (Redis; skips private document_id asks)
# =============================================================================
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=86400

# =============================================================================
# Stage S2 — DB hybrid search
# =============================================================================
# HYBRID_SEARCH_ENABLED=true
# HYBRID_SEARCH_THRESHOLD=500
# HYBRID_RETRIEVAL_CACHE_SECONDS=900
# EMBED_QUERY_CACHE_SECONDS=86400

# =============================================================================
# Stage S3 — LLM throughput
# =============================================================================
# RAG_MAX_PARALLEL_PARCELS=4
# RAG_GLOBAL_LLM_INFLIGHT=60
# LLM_SLOT_TTL_SECONDS=300
# LLM_SLOT_WAIT_SECONDS=120
# RAG_RETRY_SKIP_WHEN_RETRIEVAL_STRONG=true
# RAG_RETRY_MIN_TOP_RRF_SCORE=0.035
# RAG_RETRY_MIN_RETURNED_RATIO=0.75

# =============================================================================
# Stage S3b — async ask API (202 + poll; Redis required with multiple uvicorn workers)
# =============================================================================
# ASK_ASYNC_ENABLED=false
# ASK_ASYNC_DEFAULT=false
# ASK_JOB_WORKER_ENABLED=false
# ASK_JOB_WORKER_CONCURRENCY=4
# ASK_JOB_TTL_SECONDS=3600
# ASK_JOB_SLOT_WAIT_SECONDS=600

# =============================================================================
# RAG models / retrieval (defaults match production quality policy)
# =============================================================================
# RAG_ROUTER_MODEL=gpt-4o-mini
# RAG_SYNTHESIS_MODEL=gpt-4o
# RAG_TOP_K=20
# RAG_PARCEL_SIZE=5
# RAG_RRF_K=60
# RAG_RETRIEVAL_CANDIDATE_LIMIT=40
# DISABLE_CHUNK_EMBEDDINGS=false

# =============================================================================
# Scripts / gate tests (optional)
# =============================================================================
# GATE_TEST_API_BASE=http://localhost:8000
