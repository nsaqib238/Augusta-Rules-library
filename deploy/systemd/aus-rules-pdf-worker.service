[Unit]
Description=Augusta-Rules-library PDF processing worker
After=network-online.target
Wants=network-online.target

[Service]
User=ragadmin
WorkingDirectory=/home/ragadmin/ragadmin/projects/Augusta-Rules-library/backend
Environment="PYTHONUNBUFFERED=1"
Environment="WORKER_MODE=pdf"
Environment="EXTERNAL_PDF_WORKER=true"
EnvironmentFile=-/home/ragadmin/ragadmin/projects/Augusta-Rules-library/backend/.env
ExecStart=/home/ragadmin/ragadmin/projects/Augusta-Rules-library/backend/venv/bin/python worker_main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
