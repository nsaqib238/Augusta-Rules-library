# ===========================================
# AUGUSTASEARCH (augustasearch.com) - FRONTEND ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control!
# 
# Note: All React environment variables MUST be prefixed with REACT_APP_
# ===========================================

# ===========================================
# DATABASE CONFIGURATION (REQUIRED)
# ===========================================
# Connection URL and anon key from your database project settings API page
# IMPORTANT: Use ANON key, NOT service role key!
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Contact support mailto links in the UI
REACT_APP_SUPPORT_EMAIL=naajm@augustasearch.com

# Optional: comma-separated admin emails (UI only — backend uses ADMIN_EMAIL_ALLOWLIST)
# REACT_APP_ADMIN_EMAIL_ALLOWLIST=you@example.com,ops@example.com

# ===========================================
# API CONFIGURATION
# ===========================================
# Local dev: point at your FastAPI port
REACT_APP_API_URL=http://localhost:8000
# Production (same host as SPA on VPS): omit this line or leave empty so requests use
# the same origin as the page (avoids a wrong baked-in https://... host).

# ===========================================
# STRIPE CONFIGURATION (REQUIRED for subscriptions)
# ===========================================
# Get from: https://dashboard.stripe.com/test/apikeys
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ===========================================
# STRIPE PRICING TABLE (Optional)
# ===========================================
# Get from: https://dashboard.stripe.com/test/pricing-tables
REACT_APP_STRIPE_PRICING_TABLE_ID=prctbl_your_pricing_table_id_here

# ===========================================
# STRIPE CUSTOMER PORTAL (Optional)
# ===========================================
# Get from: https://dashboard.stripe.com/settings/billing/portal
REACT_APP_STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/test_6oUfZa8vv5sF9R7cUQ4wM01

# ===========================================
# GOOGLE reCAPTCHA (Optional but Recommended)
# ===========================================
# Get from: https://www.google.com/recaptcha/admin
# Site Key: Use in frontend (public)
REACT_APP_RECAPTCHA_SITE_KEY=6Ld...your_site_key_here
# Secret Key: Use in backend (keep secret) - add to backend/.env
# RECAPTCHA_SECRET_KEY=6Ld...your_secret_key_here

