# ===========================================
# Augusta Rules Library (library.augustasearch.com)
# ===========================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env. DO NOT reuse Augusta-Australia (ausstd) Supabase keys.
# See APP_SEPARATION.md
#
# Note: All React environment variables MUST be prefixed with REACT_APP_
# ===========================================

# ===========================================
# DATABASE CONFIGURATION (REQUIRED)
# ===========================================
# Library Supabase project — ANON key only (NOT the upload/ausstd project)
REACT_APP_SUPABASE_URL=https://your-library-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Contact support mailto links in the UI
REACT_APP_SUPPORT_EMAIL=naajm@augustasearch.com

# Optional: comma-separated admin emails (UI only — backend uses ADMIN_EMAIL_ALLOWLIST)
# REACT_APP_ADMIN_EMAIL_ALLOWLIST=you@example.com,ops@example.com

# ===========================================
# API CONFIGURATION
# ===========================================
# Local: use 8001 if Augusta-Australia already uses 8000
REACT_APP_API_URL=http://localhost:8001
# Production (same host as SPA on VPS): omit this line or leave empty so requests use
# the same origin as the page (avoids a wrong baked-in https://... host).

# ===========================================
# STRIPE — use a SEPARATE Stripe setup from Augusta-Australia
# ===========================================
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
REACT_APP_STRIPE_PRICING_TABLE_ID=prctbl_your_pricing_table_id_here
# Must NOT be the ausstd customer portal
REACT_APP_STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/test_your_library_portal

# ===========================================
# GOOGLE reCAPTCHA (Optional but Recommended)
# ===========================================
REACT_APP_RECAPTCHA_SITE_KEY=6Ld...your_site_key_here
